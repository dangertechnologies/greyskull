{
  "name": "greyskull",
  "version": "1.1.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo/ui": "~58.0.29",
    "@kingstinct/react-native-healthkit": "^16.2.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^58.0.0",
    "expo-ai": "^0.3.0",
    "expo-app-intents": "~0.5.18",
    "expo-asset": "~58.0.21",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "expo-widgets": "~58.0.29",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-health-connect": "^4.1.3",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "~19.3.0",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.15",
    "react-server-dom-webpack": "~19.3.1",
    "react-test-renderer": "19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "test": "jest --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test:scripts": "node --test scripts/*.test.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:scripts",
    "build:preview": "eas build --profile preview --platform ios",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --profile production --platform ios --latest",
    "submit:android": "eas submit --profile production --platform android --latest",
    "release:ios": "pnpm check && eas build --profile production --platform ios --auto-submit",
    "release:android": "pnpm check && eas build --profile production --platform android --auto-submit",
    "update": "eas update --branch production"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testTimeout": 20000,
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/scripts/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.tsx"
    ]
  },
  "packageManager": "pnpm@10.28.0"
}
