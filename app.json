{
  "expo": {
    "name": "Greyskull LP",
    "slug": "greyskull",
    "scheme": "gslp",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "bundleIdentifier": "com.dangertechnologies.gslp",
      "buildNumber": "2",
      "supportsTablet": false
    },
    "android": {
      "package": "com.greyskull",
      "versionCode": 2
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      "expo-web-browser",
      "expo-asset",
      "expo-font",
      "expo-notifications"
    ]
  }
}
